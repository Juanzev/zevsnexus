# ZEVS Nexus — variáveis de ambiente do backend.
# Copie para backend/.env (fora do git). Em produção, as variáveis ficam no Render.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# URL pública do app (base dos links de e-mail; nunca o header Host). Sem barra no fim.
APP_URL=http://localhost:3000
# Origens extras permitidas além de APP_URL (separadas por vírgula). Nunca "*".
CORS_ORIGIN=

# Banco local do projeto (npm run db:local -- setup): cluster próprio na porta 5434.
DATABASE_URL=postgres://postgres@localhost:5434/zevs_nexus_dev
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Gere com: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d
REFRESH_FAMILY_MAX_AGE=30d
# Produção exige no mínimo 12.
BCRYPT_ROUNDS=12

# O backend serve a SPA (frontend/) na mesma origem.
SERVE_FRONTEND=true
TRUST_PROXY=1
# Segredo da Transform Rule do Cloudflare (X-Origin-Auth). Só em staging/produção.
CF_ORIGIN_SECRET=

# E-mail: "log" não envia nada (grava em EMAIL_OUTBOX_DIR, se definido); "resend" envia de verdade.
EMAIL_PROVIDER=log
EMAIL_OUTBOX_DIR=../.outbox
RESEND_API_KEY=
EMAIL_FROM=ZEVS Nexus <no-reply@localhost>

JOBS_ENABLED=false
